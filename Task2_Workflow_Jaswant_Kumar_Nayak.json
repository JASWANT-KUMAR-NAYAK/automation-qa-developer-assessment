    {
      "parameters": {
        "jsCode": "const repositories = $input.all();\n\nreturn repositories.map(item => {\n  const data = item.json;\n\n  const repository = data.repoName ||\n    data.repository ||\n    `${data.owner}/${data.name === 'README.md' ? '' : data.name}`.replace(/\\/$/, '');\n\n  return {\n    json: {\n      repository: String(repository).trim(),\n      description: String(data.description || 'No description available').trim(),\n      stars: Number(data.stars || 0),\n      language: String(data.language || 'Not specified').trim(),\n      repository_url: `https://github.com/${repository}`,\n      readme_url: data.html_url || null,\n      readme_size_bytes: Number(data.size || 0),\n      readme_status: data.html_url ? 'Available' : 'Unavailable',\n      readme_error: data.error?.message || '',\n      priority: Number(data.stars || 0) > 1000 ? 'High' : 'Normal',\n      generated_at: new Date().toISOString()\n    }\n  };\n});"
      },
